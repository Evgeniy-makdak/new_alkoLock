# AI для отчётов (dev proxy: POST /api/reports-ai/compose)
# Скопируйте в .env.local / окружение yarn start:
# GEMINI_API_KEY=your_google_ai_studio_key
# или
# REACT_APP_GEMINI_API_KEY=your_google_ai_studio_key
#
# Опционально модель:
# REPORTS_AI_GEMINI_MODEL=gemini-2.0-flash
#
# Без ключа фронт использует локальный разбор (local_fallback).
GEMINI_API_KEY=
