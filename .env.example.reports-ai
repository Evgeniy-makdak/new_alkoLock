# AI для отчётов (dev proxy: POST /api/reports-ai/compose)
# Скопируйте в .env.local / окружение yarn start:
# GEMINI_API_KEY=your_google_ai_studio_key
# или
# REACT_APP_GEMINI_API_KEY=your_google_ai_studio_key
#
# Альтернативный бесплатный провайдер (фолбэк):
# OPENROUTER_API_KEY=your_openrouter_key
# или
# REACT_APP_OPENROUTER_API_KEY=your_openrouter_key
#
# Опционально модели:
# REPORTS_AI_GEMINI_MODEL=gemini-2.0-flash
# REPORTS_AI_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
#
# Ключи также можно ввести в рантайме в настройках AI-отчётов (localStorage) —
# тогда env не нужен, и это работает в production (Electron/Docker).
#
# Для статического web/Docker укажите URL serverless-прокси в public/config.json:
#   "reportsAiUrl": "https://<worker>.workers.dev/api/reports-ai/compose"
# (см. serverless/cloudflare-worker.js)
#
# Без ключа фронт использует локальный разбор (local_fallback).
GEMINI_API_KEY=
