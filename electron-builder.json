{
  "extends": null,
  "appId": "ru.alcolocks.operator",
  "productName": "Alcolocks Operator",
  "directories": {
    "app": "electron",
    "output": "release"
  },
  "files": [
    "**/*"
  ],
  "extraResources": [
    {
      "from": "electron/app.config.json",
      "to": "app.config.json"
    }
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": [
      "nsis",
      "portable"
    ]
  },
  "mac": {
    "category": "public.app-category.business",
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Alcolocks Operator",
    "artifactName": "${productName} Setup-${version}-${arch}.${ext}",
    "uninstallDisplayName": "Alcolocks Operator"
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
  }
}
