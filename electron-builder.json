{
  "extends": null,
  "appId": "ru.alcolocks.operator",
  "productName": "Alkozamok-SMART",
  "executableName": "Alkozamok-SMART",
  "icon": "electron/app-icon.ico",
  "afterPack": "scripts/after-pack.cjs",
  "directories": {
    "app": "electron",
    "output": "release"
  },
  "files": [
    "**/*",
    "!web-dist/**"
  ],
  "extraResources": [
    {
      "from": "electron/app.config.json",
      "to": "app.config.json"
    },
    {
      "from": "public/favicon-32x32.png",
      "to": "favicon-32x32.png"
    },
    {
      "from": "electron/app-icon.ico",
      "to": "app-icon.ico"
    }
  ],
  "win": {
    "icon": "electron/app-icon.ico",
    "signAndEditExecutable": false,
    "target": [
      "nsis",
      "portable"
    ]
  },
  "mac": {
    "icon": "electron/app-icon-512.png",
    "category": "public.app-category.business",
    "target": [
      "dmg"
    ],
    "artifactName": "Alkozamok-SMART-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Алкозамок-М СМАРТ",
    "installerIcon": "electron/app-icon.ico",
    "uninstallerIcon": "electron/app-icon.ico",
    "installerHeaderIcon": "electron/app-icon.ico",
    "artifactName": "Alkozamok-SMART-Setup-${version}-${arch}.${ext}",
    "uninstallDisplayName": "Информационная система «Алкозамок-М СМАРТ»",
    "runAfterFinish": true,
    "include": "build/installer.nsh"
  },
  "portable": {
    "artifactName": "Alkozamok-SMART-${version}-portable-${arch}.exe"
  }
}
