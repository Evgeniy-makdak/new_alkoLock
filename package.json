{
  "$schema": "./node_modules/react-scripts/package.json",
  "name": "alcolocks",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:8080",
  "dependencies": {
    "@devfamily/admiral": "^5.12.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hookform/resolvers": "^3.3.4",
    "@maplibre/maplibre-gl-leaflet": "0.1.3",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@mui/system": "^6.4.5",
    "@mui/x-data-grid": "^6.19.2",
    "@mui/x-date-pickers": "^6.19.3",
    "@parcel/watcher": "^2.4.1",
    "@stomp/stompjs": "^7.0.0",
    "@tanstack/react-query": "^5.17.19",
    "@tinymce/tinymce-react": "^5.1.1",
    "@types/leaflet": "^1.9.19",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.7",
    "centrifuge": "^5.4.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.15",
    "i18next": "^23.7.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.11.12",
    "lodash": "^4.17.21",
    "maplibre-gl": "^4.7.1",
    "notistack": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.59.0",
    "react-i18next": "^14.0.0",
    "react-icons": "^5.5.0",
    "react-input-mask": "3.0.0-alpha.2",
    "react-intl-tel-input": "^8.2.0",
    "react-loading-overlay": "^1.0.1",
    "react-loading-overlay-ts": "^2.0.2",
    "react-phone-input-2": "^2.15.1",
    "react-phone-number-input": "^3.3.9",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.7.7",
    "react-virtuoso": "^4.7.7",
    "recharts": "2.15.0",
    "sass": "^1.68.0",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.1",
    "yup": "^1.4.0",
    "zustand": "^4.5.0"
  },
  "scripts": {
    "test": "craco test",
    "eject": "craco eject",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.+(ts|tsx|css|md)\"",
    "postinstall": "node scripts/postinstall.js",
    "prepare": "husky install",
    "precommit": "yarn format && yarn lint && yarn lint:fix",
    "watch": "yarn typed-scss-modules src --watch",
    "start": "cross-env SASS_WARN_DEPRECATION=0 craco start --silent",
    "build": "cross-env ESLINT_NO_CACHE=1 SASS_WARN_DEPRECATION=0 craco build --silent",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none SASS_WARN_DEPRECATION=0 craco start --silent\" \"wait-on http://localhost && cross-env ELECTRON_APP_URL=http://localhost/authorization electron electron/main.cjs\"",
    "electron:prepare:win": "node scripts/prepare-electron-icons.cjs",
    "electron:pack": "yarn electron:pack:win",
    "electron:pack:win": "yarn electron:prepare:win && node scripts/clean-release.cjs && electron-builder --config electron-builder.json --win portable --x64",
    "electron:setup:win": "yarn electron:prepare:win && node scripts/clean-release.cjs && electron-builder --config electron-builder.json --win nsis --x64",
    "electron:pack:mac": "electron-builder --config electron-builder.json --mac dmg --x64 --arm64",
    "electron:dist": "yarn electron:dist:win",
    "electron:dist:win": "yarn electron:prepare:win && node scripts/clean-release.cjs && electron-builder --config electron-builder.json --win nsis portable --x64",
    "electron:dist:mac": "electron-builder --config electron-builder.json --mac dmg --x64 --arm64"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "@craco/craco": "^7.1.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/babel__traverse": "^7.20.6",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.14.202",
    "@types/react": "18.2.55",
    "@types/react-dom": "^18.2.18",
    "@types/react-input-mask": "^3.0.1",
    "@types/react-loading-overlay": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "8",
    "cross-env": "^10.1.0",
    "electron": "33",
    "electron-builder": "24",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.2",
    "rcedit": "4",
    "react-app-alias": "^2.2.2",
    "sass-migrator": "^2.0.2",
    "typed-scss-modules": "^8.0.0",
    "typescript": "^5.3.3",
    "wait-on": "7"
  },
  "lint-staged": {
    "*.tsx": "eslint --cache --fix",
    "*.ts": "eslint --cache --fix",
    "*.{css,scss}": "prettier --write"
  }
}
